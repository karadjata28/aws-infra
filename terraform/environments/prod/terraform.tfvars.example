# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.

# Which account this environment goes into. Terraform stops if the profile doesn't match.
aws_profile    = "production"   # profile that logs into the Production account
aws_account_id = "123456789012" # <- the PRODUCTION account ID

aws_region  = "eu-central-1"
project     = "training" # must match the project name used in bootstrap
environment = "prod"

# PROD: keep this true. Only set false if you really want to delete prod and its data.
deletion_protection = true

# PROD keeps old file versions longer than dev (30), so more history can be recovered.
app_version_retention_days = 90

# Which AWS service runs the app and assumes the app role.
app_service_principals = ["lambda.amazonaws.com"]
