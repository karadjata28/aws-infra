# One values file PER ACCOUNT. Copy this to management.tfvars, develop.tfvars and
# production.tfvars, and fill in each account's values. *.tfvars files are git-ignored.
#
#   File               aws_profile    aws_account_id
#   management.tfvars  "management"   <Management account ID>
#   develop.tfvars     "default"      <Develop account ID>
#   production.tfvars  "production"   <Production account ID>

aws_profile                  = "default"
aws_account_id               = "123456789012"
aws_region                   = "eu-central-1"
project                      = "training"
state_version_retention_days = 90
