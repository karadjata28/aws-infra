# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored,
# so real email addresses and account IDs stay out of git.

aws_profile    = "management"
aws_account_id = "123456789012" # <- the MANAGEMENT account ID

# Spending limit for ALL accounts together.
budget_name              = "Monthly-20USD"
monthly_budget_usd       = "20.0"
alert_emails             = ["you@example.com"]
alert_thresholds_percent = [25, 50, 80, 100]
block_threshold_percent  = 90

# Accounts that get blocked at the limit: Develop and Production (never Management).
workload_account_ids = ["111111111111", "222222222222"]

# The spend-limit SCP created by AWS Budgets ("BudgetsSpendLimitDenyNewWorkloads").
# Find it with: aws organizations list-policies --filter SERVICE_CONTROL_POLICY --profile management
spend_limit_scp_id = "p-xxxxxxxx"
